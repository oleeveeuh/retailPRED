{
  "name": "retailpred",
  "version": "1.0.0",
  "description": "Full-Stack Retail Sales Forecasting System with ML Model Explainability",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" -n \"FRONTEND,BACKEND\" -c \"bgBlue.bold,bgGreen.bold\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python main.py",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oleeveeuh/retailPRED.git"
  },
  "keywords": [
    "forecasting",
    "machine-learning",
    "retail",
    "shap",
    "fastapi",
    "react"
  ],
  "author": "Olivia Liau",
  "license": "MIT",
  "dependencies": {
    "react-is": "^19.2.3"
  }
}
