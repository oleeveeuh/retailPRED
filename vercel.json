{
  "headers": [
    {
      "source": "/demo-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "cd frontend && bash vercel-build.sh",
  "outputDirectory": "frontend/dist"
}