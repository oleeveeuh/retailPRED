# RetailPRED environment variables (template)
#
# Copy to project_root/.env (git-ignored) and fill in real values.
# Never commit the real .env file.

# --- External data APIs -----------------------------------------------------
# U.S. Census Bureau API key (MRTS retail sales). Required for
# weekly_validation.py / backfill_actuals.py. Free key:
# https://api.census.gov/data/key_signup.html
MRTS_API_KEY=

# FRED (Federal Reserve Economic Data) key. Used by project_root/etl/fetch_fred.py.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage (market data features). Optional.
ALPHA_VANTAGE_KEY=

# --- TimeCopilot agent (optional, legacy training pipeline) -----------------
TIMECOPILOT_ECON_API_KEY=
TIMECOPILOT_FINANCE_API_KEY=
TIMECOPILOT_MULTIVARIATE_API_KEY=

# --- Snowflake (optional; not used by the demo backend) ---------------------
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# --- Airflow (optional) ------------------------------------------------------
# Path to the repository on the machine running the Airflow DAG
RETAILPRED_DIR=
