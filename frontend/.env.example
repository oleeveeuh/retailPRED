# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Demo mode configuration
# true = use static JSON files (for Vercel demo deployment)
# false = call backend API (for local development with full features)
VITE_DEMO_MODE=false

# Backend API URL
# Only used when VITE_DEMO_MODE=false
# For local development: http://localhost:8000
# For production: https://your-backend-api.com
VITE_API_URL=http://localhost:8000

# Tableau Public Embed URL
# URL of your Tableau Public visualization for Business Dashboard
# Format: "https://public.tableau.com/views/WORKBOOK_NAME/SHEET_NAME?:params"
# Example: "https://public.tableau.com/views/Book1_17676501972860/Sheet1?:language=en-US&:sid=&:redirect=auth&:display_count=n&:origin=viz_share_link"
VITE_TABLEAU_EMBED_URL=""

# Optional: Debug mode (shows detailed logs)
VITE_DEBUG=false
