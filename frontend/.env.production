# Production Environment Variables
# For Vercel deployment (static demo mode)

# Demo mode: true = use static JSON, false = call backend API
# For Vercel static deployment, we use demo mode
VITE_DEMO_MODE=true

# Backend API URL (not used in demo mode, but kept for reference)
# If deploying backend separately, set this to your backend URL
VITE_API_URL=

# Tableau Public Embed URL (for Business Dashboard)
VITE_TABLEAU_EMBED_URL="https://public.tableau.com/views/Book1_17676501972860/Sheet1?:language=en-US&:sid=&:redirect=auth&:display_count=n&:origin=viz_share_link"
