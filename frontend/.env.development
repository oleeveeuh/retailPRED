# Development Environment Variables
# For local development with backend API

# Demo mode: false = call backend API, true = use static JSON
VITE_DEMO_MODE=false

# Backend API URL (only used when VITE_DEMO_MODE=false)
VITE_API_URL=http://localhost:8000

# Tableau Public Embed URL (for Business Dashboard)
VITE_TABLEAU_EMBED_URL="https://public.tableau.com/views/Book1_17676501972860/Sheet1?:language=en-US&:sid=&:redirect=auth&:display_count=n&:origin=viz_share_link"
